{
    "name": "company-os/laravel",
    "description": "Server half of the Company OS recipes: ReasonRequest, AuditChanges, Csv, TrashBin, SetupSteps, GlobalSearch, ServiceStatus, UserTime.",
    "type": "library",
    "license": "proprietary",
    "keywords": [
        "laravel",
        "company-os",
        "audit",
        "trash",
        "search"
    ],
    "require": {
        "php": "^8.3",
        "laravel/framework": "^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^4.0"
    },
    "suggest": {
        "spatie/laravel-activitylog": "Default AuditLogger and trash who + reason lookup read and write activity rows through it."
    },
    "autoload": {
        "psr-4": {
            "CompanyOs\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CompanyOs\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "CompanyOs\\CompanyOsServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "pest"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
